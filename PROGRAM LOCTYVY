void readDHT() {
  h = dht.readHumidity();
  t = dht.readTemperature();
  temp = String(t);
  humi = String(h);

  if (isnan(h) || isnan(t)) {
    h = 0;
    t = 0;
    temp = String(t);
    humi = String(h);
    Serial.println("Failed to read from DHT sensor!");
  }

  ApiDHT(temp, humi);
}

void readObs() {
  valueobs = digitalRead(OBSTACLE);
  if (valueobs == 0) {
    String Strobs = "0";
    digitalWrite(LEDSTRIP, HIGH);
    ApiObs(Strobs);
  } else {
    String Strobs = "1";
    digitalWrite(LEDSTRIP, LOW);
    ApiObs(Strobs);
  }
  //Serial.println(valueobs);
}

