  void connectWifi() {
  WiFi.begin(ssid, password);
  Serial.println("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }
  Serial.println("\nConnected to WiFi");
}

  // read diagnostics (optional but can help debug problems)
  void loop() {
  getCode();
  readDHT();
  readObs();

  if (restart) {
    return RST_DEVICE();
  }

  if (APIHealt == "No") {
    lcdIdleError();
  } else if (stats && state) {
    lcdRentLocker();
  } else if (stats && !state) {
    lcdUnrentLocker();
  } else {
    if (state) {
      if (justopen) {
        solOpen();
        if (codeopen == 1) {
          lcdRentSuccess();
        } else if (codeopen == 2) {
          lcdOpenSuccess();
        } else if (codeopen == 3) {
          lcdUnrentSuccess();
        }
      } else {
        solClose();
        lcdIdleUnLock();
        pilotGreen();
      }
    } else {
      if (justopen) {
        solOpen();
        if (codeopen == 1) {
          lcdRentSuccess();
        } else if (codeopen == 2) {
          lcdOpenSuccess();
        } else if (codeopen == 3) {
          lcdUnrentSuccess();
        }
      } else {
        solClose();
        lcdIdleLock();
        pilotRed();
      }
    }
  }

  delay(1000);  // Wait before sending the next request
}

